{
	"name": "zealbyte/bytegazette",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"description": "Add some elegant pizzazz to your site with a good clean fun design and a material style layout with this simple and easy to use theme based on UIKit 3.",
	"homepage": "https://zealbyte.org/projects/bytegazette",
	"keywords": [
		"wordpress", "wp", "bbpress", "comments", "blog", "news"
	],
	"support": {
		"forum": "https://zealbyte.org/support/bytegazette",
		"issues": "https://github.com/zealbyte/bytegazette/issues",
		"source": "https://github.com/zealbyte/bytegazette"
	},
	"authors": [
		{
			"name": "Dustin Martella",
			"email": "dustin.martella@zealbyte.com",
			"homepage": "https://zealbyte.org/authors/dustinmartella"
		}
	],
	"require": {
		"php": "^7.1|^8.0",
		"composer/installers": "~1.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/php-compatibility": "^9.3",
		"phpunit/phpunit": "^11.5",
		"squizlabs/php_codesniffer": "^3.11",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"scripts": {
		"lint": "phpcs"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
